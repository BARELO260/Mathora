{
  "name": "mathora",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --configLoader native --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "build": "vite build --configLoader native && node scripts/write-precache.mjs",
    "test": "node --test",
    "icons": "node scripts/generate-icons.mjs",
    "release:check": "node scripts/check-release.mjs",
    "android:sync": "npm run icons && npm run build && cap sync android",
    "android:compile": "npm run android:sync && node scripts/build-android.mjs lintRelease assembleRelease",
    "android:bundle": "npm run android:sync && npm run release:check && node scripts/build-android.mjs bundleRelease",
    "android:open": "cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "prettier": "^3.9.9",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "mathjs": "^15.2.0",
    "nerdamer": "^1.1.13"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
